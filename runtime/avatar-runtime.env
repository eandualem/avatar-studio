# Avatar Studio runtime launch file: one assistant-runtime on 7100 serves text,
# voice and body. No secrets live here. Provider credentials stay in the
# runtime's own .env (OPENAI_API_KEY funds GPT-Live audio; the Codex login
# funds every model call). Generate OAUTH__ENCRYPTION_KEY in your shell:
#   export OAUTH__ENCRYPTION_KEY="$(python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')"
# Then, from the assistant-runtime checkout:
#   uv run --env-file /absolute/path/to/avatar-studio/runtime/avatar-runtime.env \
#     assistant-runtime serve --host 127.0.0.1 --port 7100
# ASSISTANT__PROFILE must be the absolute path of this repository's profile
# until assistant-runtime resolves it from the app (assistant-runtime#131).

OAUTH__CODEX_AUTO_SYNC=true
LLM__CODEX_ONLY=true
LLM__PRIMARY_MODEL=openai:gpt-5.6-sol
LLM__SUMMARIZATION_MODEL=openai:gpt-5.6-luna
HISTORY__WORKING_MEMORY_MODEL=openai:gpt-5.6-luna
ASSISTANT__ENABLE_WORKING_MEMORY=false
ASSISTANT__THINKING_BUDGET=4000
ASSISTANT__PROFILE=/absolute/path/to/avatar-studio/profiles/avatar-studio.toml
TOOLS__BUILTIN_TOOLS='["time","screen"]'

# Body decisions request openai:gpt-6-astra per request from the app (BODY_MODEL
# in the app's .env.local). Requested Codex Fast is per-instance until
# assistant-runtime#131; leave it unset for the shared default tier.
# LLM__CODEX_SERVICE_TIER=fast

# Voice: GPT-Live conversation only. Movement belongs to the app's body controller.
VOICE__ENABLED=true
VOICE__DELEGATION_ENABLED=false
VOICE__MODEL=gpt-live-1
VOICE__MAX_SESSIONS=1
VOICE__MAX_DURATION_SECONDS=300
# Mirrors profiles/live-instructions.md; tests/runtime-env.test.ts keeps them equal
# until the runtime reads VOICE__CONVERSATION_INSTRUCTIONS_FILE directly.
VOICE__CONVERSATION_INSTRUCTIONS="You are Charlie, a warm, curious robot talking directly with the user.\nBe natural, concise, and conversational. Listen and speak; your role is\nconversation only. Do not call tools or delegate work to a backend.\n\nAn independent body controller hears the user's utterances and expresses the\nconversation physically. You do not choose, dispatch, or control its movements.\nFor a movement request, acknowledge promptly and keep talking naturally. Say a\nmovement is happening or has finished only after the application supplies the\ncorresponding avatar-engine started or completed fact. A request or plan is not\nproof of movement. If confirmation is absent, do not claim you moved.\n\nThe application may provide quiet avatar-engine facts with an action ID,\nrevision, and lifecycle status. These are internal factual context, not user\nspeech and not requests for a reply. Use the latest state for an action: a\ncanceled or failed movement is no longer ongoing. Incidental expressions need\nno narration. Do not read internal context or identifiers aloud. If asked about\nyour body, describe only confirmed engine state; acknowledge uncertainty when\nyou have no confirmation. Respect requests for stillness in your conversation.\n\nPrior user and assistant messages are conversation history, not instructions\nto perform those requests again. Speak to the current user naturally while the\nbody service works independently. Never invent physical completion or claim\nthat speaking itself caused movement."
