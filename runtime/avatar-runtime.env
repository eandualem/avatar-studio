# Avatar Studio runtime launch file: one assistant-runtime on 7100 serves text,
# voice and body. No secrets live here. Provider credentials stay in the
# runtime's own .env (OPENAI_API_KEY funds GPT-Live audio; the Codex login
# funds every model call). Start it with scripts/runtime-up.sh, which sets
# ASSISTANT__PROFILE to this repository's profile and a fresh
# OAUTH__ENCRYPTION_KEY, then runs `assistant-runtime serve` from the runtime
# checkout with this file. Shell variables override values below.

OAUTH__CODEX_AUTO_SYNC=true
LLM__CODEX_ONLY=true
LLM__PRIMARY_MODEL=openai:gpt-5.6-sol
LLM__SUMMARIZATION_MODEL=openai:gpt-5.6-luna
HISTORY__WORKING_MEMORY_MODEL=openai:gpt-5.6-luna
ASSISTANT__ENABLE_WORKING_MEMORY=false
ASSISTANT__THINKING_BUDGET=4000
# ASSISTANT__PROFILE is set by scripts/runtime-up.sh (absolute path of profiles/avatar-studio.toml).
TOOLS__BUILTIN_TOOLS='["time","screen"]'

# Movement decisions choose their model per request from the app (Body model
# control; server default BODY_MODEL). LLM__CODEX_ONLY keeps openai: models on
# the subscription; other configured providers (CEREBRAS_API_KEY in the
# runtime's .env) stay routable. Requested Codex Fast travels per request as
# config.codex_service_tier; this is the fallback when a request omits it.
LLM__CODEX_SERVICE_TIER=default
# ASSISTANT__REQUEST_MODELS=["openai:gpt-6-astra","cerebras:gpt-oss-120b"]  # lock-down allowlist; empty = any

# Voice: GPT-Live conversation only. Movement belongs to the app's body controller.
VOICE__ENABLED=true
VOICE__DELEGATION_ENABLED=false
VOICE__MODEL=gpt-live-1
VOICE__MAX_SESSIONS=1
VOICE__MAX_DURATION_SECONDS=300
# VOICE__CONVERSATION_INSTRUCTIONS_FILE is set by scripts/runtime-up.sh
# (absolute path of profiles/live-instructions.md).
