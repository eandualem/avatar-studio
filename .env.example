# Server-only URL. Start assistant-runtime with profiles/avatar-studio.toml.
RUNTIME_URL=http://127.0.0.1:7100
# Optional separate GPT-Live runtime; otherwise RUNTIME_URL handles both modes.
# Requires assistant-runtime with its voice extra and server-side OpenAI key.
VOICE_RUNTIME_URL=http://127.0.0.1:7110
# For the isolated Codex subscription setup, point BOTH URLs to its runtime.
# See docs/codex-subscription.md. GPT-Live audio still uses separate API access.
