# Server-only settings; the browser never sees them. Provider credentials stay
# in assistant-runtime. One runtime serves text, voice and body:
RUNTIME_URL=http://127.0.0.1:7100

# Every request sends the registered profile "avatar_studio" and these
# app-owned model choices on the shared instance (defaults shown).
# TEXT_MODEL=openai:gpt-5.6-sol
# TEXT_THINKING_BUDGET=4000
# BODY_MODEL=openai:gpt-6-astra
# BODY_THINKING_BUDGET=4000
# AUXILIARY_MODEL=openai:gpt-5.6-luna   # summarization and working-memory model

# Optional overrides if you deliberately run separate runtime instances.
# VOICE_RUNTIME_URL=http://127.0.0.1:7100
# BODY_RUNTIME_URL=http://127.0.0.1:7100

# TypeSafe Jev drives Charlie's expression during a live call through the
# runtime's decisions. The key (TYPESAFE_API_KEY) and the model
# (DECISIONS__MODEL) are the runtime's configuration, not this app's; without
# them a call still works but the body stays idle (typed chat still moves him).
